#
# Mirrors espos/sdkconfig.defaults.esp32.
#
# ESP32 (original): RSA app signing (the Secure Boot V2 scheme this project
# uses in sdkconfig.defaults) needs chip revision >= 3.0. Without this the
# build falls back to the V1 ECDSA scheme and the signing step dies with
# "'RSAPrivateKey' object has no attribute 'curve'", because CMake generated
# an RSA key. Every module sold since 2020 (WROOM-32E/UE, WROVER-E) is rev 3.
CONFIG_ESP32_REV_MIN_3=y
