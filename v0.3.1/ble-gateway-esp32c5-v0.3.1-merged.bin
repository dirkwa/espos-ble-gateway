B0123456789abcdef␀<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>espOS</title>
<style>
  body { font: 15px/1.45 system-ui, sans-serif; margin: 1.5rem auto; max-width: 44rem; padding: 0 1rem; color: #222; }
  h1 { font-weight: 600; margin-bottom: 0; }
  h3 { margin: 1.4rem 0 .4rem; }
  .sub { color: #666; margin-top: .25rem; }
  pre { background: #f4f4f4; padding: .75rem; border-radius: 6px; overflow-x: auto; font-size: 13px; }
  .row { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; margin: .5rem 0; }
  input, select, button { font: inherit; padding: .4rem .6rem; }
  input { min-width: 12rem; }
  .badge { display: inline-block; padding: .1rem .5rem; border-radius: 1rem; background: #ddd; font-size: 13px; }
  .ok { background: #cfe9cf; } .bad { background: #f3d1d1; } .warn { background: #f7e7b5; }
  #msg { color: #a33; }
</style>
</head>
<body>
<h1>espOS</h1>
<p class="sub">Setup page (the full UI arrives in M5). The API is live under <code>/api/v1</code>.</p>

<h3>WiFi <span id="wstate" class="badge">вЂ¦</span></h3>
<div id="wdetail" class="sub"></div>
<form id="wform" class="row" autocomplete="off">
  <input id="ssid" list="ssids" placeholder="Network (SSID)" required>
  <datalist id="ssids"></datalist>
  <input id="psk" type="password" placeholder="Password (empty = open)">
  <button type="submit">Join</button>
  <button type="button" id="scan">Scan</button>
</form>
<div id="msg"></div>

<h3>SignalK <span id="skstate" class="badge">вЂ¦</span></h3>
<div id="skdetail" class="sub"></div>
<div class="row">
  <select id="skservers"><option value="">(auto)</option></select>
  <button type="button" id="skuse">Use</button>
  <button type="button" id="skdiscover">Discover</button>
  <button type="button" id="skrequest">Request access</button>
  <button type="button" id="skforget">Forget token</button>
</div>
<form id="sktokform" class="row" autocomplete="off">
  <input id="sktoken" placeholder="Paste a token" style="min-width:20rem">
  <button type="submit">Use token</button>
</form>
<div id="skmsg" class="sub"></div>

<h3>System</h3>
<pre id="info">loadingвЂ¦</pre>
<h3>Configuration <a href="/api/v1/config/schema" target="_blank" style="font-size:13px;font-weight:normal">schema</a></h3>
<pre id="cfg">loadingвЂ¦</pre>

<script>
const $ = id => document.getElementById(id);
async function api(method, path, body) {
  const r = await fetch(path, { method, headers: body !== undefined ? {"Content-Type": "application/json"} : {},
                                body: body !== undefined ? JSON.stringify(body) : undefined });
  let js = null; try { js = await r.json(); } catch (e) {}
  return { ok: r.ok, status: r.status, js };
}
function showWifi(w) {
  const cls = w.state === "connected" ? "ok" : (w.state === "backoff" || w.reason.code ? "bad" : "warn");
  $("wstate").className = "badge " + cls;
  $("wstate").textContent = w.state + (w.portal && w.portal.active ? " В· portal " + w.portal.ssid : "");
  const bits = [];
  if (w.ssid) bits.push(`${w.ssid} (${w.rssi} dBm, ch ${w.channel})`);
  if (w.ip) bits.push(`IP ${w.ip}`);
  if (w.reason && w.reason.code) bits.push(`last: ${w.reason.text} [${w.reason.code}]`);
  if (w.backoff_ms) bits.push(`retry in ${Math.ceil(w.backoff_ms / 1000)} s`);
  if (w.attempt) bits.push(`attempt ${w.attempt}`);
  $("wdetail").textContent = bits.join(" В· ") || "hostname " + w.hostname;
}
async function loadAll() {
  const [i, c, w] = await Promise.all([api("GET", "/api/v1/system/info"), api("GET", "/api/v1/config"), api("GET", "/api/v1/wifi/status")]);
  $("info").textContent = JSON.stringify(i.js, null, 2);
  $("cfg").textContent = JSON.stringify(c.js, null, 2);
  if (w.js) showWifi(w.js);
}
$("wform").onsubmit = async e => {
  e.preventDefault();
  $("msg").textContent = "";
  const r = await api("PUT", "/api/v1/config", { wifi: { ssid0: $("ssid").value, psk0: $("psk").value } });
  $("msg").textContent = r.ok ? "saved вЂ” connectingвЂ¦" : `error: ${r.js && (r.js.message || r.js.error)}`;
};
$("scan").onclick = async () => {
  const r = await api("POST", "/api/v1/wifi/scan", {});
  $("msg").textContent = r.ok ? "scanningвЂ¦" : `scan failed: ${r.js && (r.js.message || r.js.error)}`;
};
function fillScan(s) {
  const dl = $("ssids"); dl.innerHTML = "";
  (s.results || []).sort((a, b) => b.rssi - a.rssi).forEach(r => {
    const o = document.createElement("option"); o.value = r.ssid; o.label = `${r.ssid} (${r.rssi} dBm, ${r.auth})`; dl.appendChild(o);
  });
  if (!s.scanning) $("msg").textContent = `${(s.results || []).length} network(s) found`;
}
function showSk(d) {
  const t = d.token, cls = t.state === "approved" || t.state === "open" ? "ok" : (t.state === "denied" || t.state === "error" ? "bad" : "warn");
  $("skstate").className = "badge " + cls; $("skstate").textContent = t.state;
  const bits = [];
  if (d.server && d.server.host) bits.push(`${d.server.name || d.server.host}:${d.server.port} (${d.server.source})`);
  if (t.pending_href) bits.push(`waiting for approval ${t.pending_s || 0}s вЂ” approve "${d.description}" in the server admin UI`);
  if (t.approved_s !== undefined) bits.push(`approved ${t.approved_s}s ago`);
  if (t.last_error) bits.push(t.last_error);
  bits.push(`clientId ${d.client_id}`);
  $("skdetail").textContent = bits.join(" В· ");
}
function fillServers(s) {
  const sel = $("skservers"); const cur = sel.value; sel.innerHTML = '<option value="">(auto)</option>';
  (s.servers || []).forEach(r => { const o = document.createElement("option"); o.value = r.self; o.textContent = `${r.name || r.host} ${r.host}:${r.port} ${r.swvers}${r.selected ? " вњ“" : ""}`; sel.appendChild(o); });
  sel.value = cur;
}
$("skuse").onclick = () => api("PUT", "/api/v1/config", { sk: { server_self: $("skservers").value } }).then(r => $("skmsg").textContent = r.ok ? "server preference saved" : "error");
$("skdiscover").onclick = () => api("POST", "/api/v1/sk/discover", {}).then(() => $("skmsg").textContent = "discoveringвЂ¦");
$("skrequest").onclick = () => api("POST", "/api/v1/sk/request", {}).then(() => $("skmsg").textContent = "requestingвЂ¦");
$("skforget").onclick = () => api("POST", "/api/v1/sk/forget", {}).then(() => $("skmsg").textContent = "token forgotten");
$("sktokform").onsubmit = e => { e.preventDefault(); api("POST", "/api/v1/sk/token", { token: $("sktoken").value }).then(r => { $("skmsg").textContent = r.ok ? "verifying tokenвЂ¦" : `error: ${r.js && r.js.message}`; $("sktoken").value = ""; }); };
api("GET", "/api/v1/sk/status").then(r => r.js && showSk(r.js));
api("GET", "/api/v1/sk/servers").then(r => r.js && fillServers(r.js));
try {
  const es = new EventSource("/api/v1/events");
  es.addEventListener("sk", e => showSk(JSON.parse(e.data)));
  es.addEventListener("sk_servers", e => fillServers(JSON.parse(e.data)));
  es.addEventListener("wifi", e => showWifi(JSON.parse(e.data)));
  es.addEventListener("wifi_scan", e => fillScan(JSON.parse(e.data)));
  es.addEventListener("config", () => api("GET", "/api/v1/config").then(c => $("cfg").textContent = JSON.stringify(c.js, null, 2)));
} catch (e) {}
loadAll();
api("GET", "/api/v1/wifi/scan").then(s => s.js && fillScan(s.js));
</script>
</body>
</html>
␀Y␀␀␀l`B␀␀␀␀p/B␀␀␀8ЖB␀␀␀@ЖB␀␀␀HЖB␀␀␀PЖB␀␀␀’BhКBМКBpКBфКBxКBяя␀␀Ђ?␀␀ЂA␀␀°A␀␀Ђ␀␀АABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/␀␀␀␀3503a744552c04dd␀␀␀␀¤O␀␀{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"urn:espos:config","title":"espOS configuration","description":"Every property is an NVS namespace; every nested property is a key in it. Values omitted from a PUT are left untouched; null resets a key to its default; secret values read back as \"********\" and that sentinel is ignored on write.","type":"object","properties":{"ble":{"type":"object","title":"BLE gateway","x-espos-version":1,"properties":{"enabled":{"title":"Enabled","description":"Master switch for the BLE gateway.","type":"boolean","default":true,"x-espos-restartRequired":true},"active_scan":{"title":"Active scan","description":"Request scan responses (more data per device, more airtime). Leave off on the ESP32-P4: active scan needs the C6 co-processor to transmit SCAN_REQ over SDIO, which is unreliable and can silence advertisements entirely.","type":"boolean","default":false},"scan_int_ms":{"title":"Scan interval","type":"integer","default":320,"minimum":3,"maximum":10240,"x-espos-unit":"ms"},"scan_win_ms":{"title":"Scan window","description":"Listening time per interval. Must not exceed the interval; window/interval is the duty cycle.","type":"integer","default":160,"minimum":3,"maximum":10240,"x-espos-unit":"ms"},"post_int_ms":{"title":"POST interval","description":"How often buffered advertisements are forwarded to the server.","type":"integer","default":2000,"minimum":250,"maximum":60000,"x-espos-unit":"ms"},"status_int_ms":{"title":"Status interval","description":"How often a status frame goes out on the control WebSocket.","type":"integer","default":30000,"minimum":1000,"maximum":600000,"x-espos-unit":"ms"},"max_pend_ads":{"title":"Advertisement buffer","description":"Advertisements held between POSTs. When full the oldest are dropped and counted, so a slow or absent server cannot exhaust memory. The buffer is one contiguous block of about 128 B per entry, allocated at start: where the heap cannot spare it the gateway logs a warning and uses a smaller buffer rather than failing to start, so on a small-RAM board the effective size may be well below this.","type":"integer","default":500,"minimum":10,"maximum":5000},"control_ws":{"title":"Control WebSocket","description":"Enables hello/status and GATT commands. With this off the gateway still forwards advertisements over HTTP, which is all that beacon-style devices (Ruuvi, Victron) need.","type":"boolean","default":true,"x-espos-restartRequired":true},"max_gatt_sess":{"title":"Max GATT connections","description":"Concurrent GATT connections advertised to the server. The Bluedroid GATT client supports at most 3.","type":"integer","default":3,"minimum":0,"maximum":3}},"additionalProperties":false,"description":"Bridges BLE devices to signalk-server's BLE provider API. Which devices are read, and how, is configured on the server - not here."},"httpd":{"type":"object","title":"HTTP server","x-espos-version":2,"properties":{"port":{"title":"TCP port","description":"Port the HTTP server listens on.","type":"integer","default":80,"minimum":1,"maximum":65535,"x-espos-restartRequired":true},"api_key":{"title":"API key","description":"Shared secret for the web UI and the REST API, sent as Authorization: Bearer or exchanged for a login cookie. Empty = no authentication, the API is open to anyone on the network. 8вЂ“64 characters; the Config page can generate one. Changing it logs every browser out.","type":"string","default":"","maxLength":64,"writeOnly":true,"format":"password","x-espos-secret":true},"session_ttl_s":{"title":"Login session lifetime","description":"How long a browser login (the espos_sid cookie) stays valid. Sessions live in RAM; a reboot ends them all.","type":"integer","default":86400,"minimum":60,"maximum":2592000,"x-espos-unit":"s"}},"additionalProperties":false,"description":"Built-in web server serving the UI and the REST API."},"net":{"type":"object","title":"Network","x-espos-version":1,"properties":{"hostname":{"title":"Hostname","description":"DHCP and mDNS name (<hostname>.local); also the SignalK source label and the name in the server's access-request list. Empty = espos-<last 4 hex of the device MAC>.","type":"string","default":"","maxLength":32,"pattern":"^[A-Za-z0-9-]*$","x-espos-restartRequired":true}},"additionalProperties":false,"description":"What the device is called on the network, whichever interface carries it."},"ota":{"type":"object","title":"Firmware updates","x-espos-version":1,"properties":{"manifest_src":{"title":"Where to look for updates","description":"url = the manifest URL below. signalk = ask the SignalK server this device is already connected to, so a device that finds its server also finds its updates and nothing has to be typed per device (needs a fleet-update plugin on that server).","type":"string","default":"url","maxLength":7,"enum":["url","signalk"]},"manifest_url":{"title":"Manifest URL","description":"http(s) URL of a version manifest (docs/ota.md). Empty = manual updates from a URL only. Ignored when the source above is signalk.","type":"string","default":"","maxLength":160},"manifest_path":{"title":"Manifest path on the server","description":"Path appended to the SignalK server's address when the source is signalk. The default is where the fleet-update plugin serves it.","type":"string","default":"/plugins/signalk-espos-updates/manifest.json","maxLength":120},"channel":{"title":"Channel","description":"Which channel of the manifest to follow, e.g. stable or beta.","type":"string","default":"stable","maxLength":15},"auto_check":{"title":"Check automatically","description":"Fetch the manifest after boot and every check interval.","type":"boolean","default":true},"check_h":{"title":"Check interval","type":"integer","default":24,"minimum":1,"maximum":168,"x-espos-unit":"h"},"auto_install":{"title":"Install automatically","description":"Install a newer build from the manifest as soon as it is found (device reboots). Off = only show it.","type":"boolean","default":false},"allow_insecure":{"title":"Skip TLS certificate check","description":"Accept any https certificate (self-signed boat servers). Images are still signature-checked.","type":"boolean","default":false},"confirm_tmo_s":{"title":"Rollback timeout","description":"A freshly installed image must reach the network within this time, else the device rolls back to the previous firmware.","type":"integer","default":600,"minimum":30,"maximum":3600,"x-espos-unit":"s"}},"additionalProperties":false,"description":"Over-the-air updates: where to look for new firmware and how careful to be about a freshly installed image."},"sk":{"type":"object","title":"SignalK server","x-espos-version":2,"properties":{"discovery":{"title":"Discover servers via mDNS","description":"Browse _signalk-http._tcp on the local network. Off = only the manual server below. Setting a manual host also stops discovery: an explicit address means that address, so nothing keeps browsing.","type":"boolean","default":true},"server_self":{"title":"Preferred server (self URN)","description":"Vessel self URN of the discovered server to use, e.g. urn:mrn:signalk:uuid:вЂ¦ Empty = first discovered server with a master role.","type":"string","default":"","maxLength":127},"server_pin":{"title":"Stay on the chosen server","description":"Never re-elect a different server once one is in use. The device keeps waiting for it to come back instead of moving to another discovered server. Off = pick a new server if the current one stops answering.","type":"boolean","default":false},"server_host":{"title":"Manual server host","description":"Host name or IP when mDNS is blocked. Empty = use discovery. When set, this address is used exclusively and mDNS discovery stops.","type":"string","default":"","maxLength":63},"server_port":{"title":"Manual server port","type":"integer","default":80,"minimum":1,"maximum":65535},"scheme":{"title":"Connection scheme","description":"auto = work it out per server: a discovered one by which mDNS service it advertises (_signalk-https._tcp means TLS), a manual host by one unauthenticated probe of http://host:port/signalk that follows a redirect to https. http and https force it. Needs a firmware built with ESPOS_SK_TLS for anything but http; without it the device logs that once and talks http.","type":"string","default":"auto","maxLength":5,"enum":["auto","http","https"]},"tls_trust":{"title":"How to trust the server certificate","description":"tofu = trust on first use: the first connection pins what the server presents (its CA and the names on the certificate, or the certificate itself when there is no CA) and every later one must match, the way ssh does. ca = hold the server to the CA in ca_pem below instead, for a fleet where the certificates are issued centrally. bundle = the public Mozilla roots only, which refuses the self-signed certificate a boat server normally has. There is no accept-anything mode. Reset a pinned certificate with DELETE /api/v1/sk/tls or the button on the SignalK page.","type":"string","default":"tofu","maxLength":6,"enum":["tofu","ca","bundle"]},"ca_pem":{"title":"CA certificate (PEM)","description":"The issuing CA for tls_trust = ca, as a PEM certificate (base64-encoded over the REST API, like any blob). Setting it anchors the device on that CA immediately, so a pre-seeded fleet connects on the first try with nothing to capture. Empty = none; then ca behaves like tofu until one arrives.","type":"string","contentEncoding":"base64","x-espos-type":"blob","x-espos-maxBytes":2048,"default":""},"description":{"title":"Access request description","description":"Shown to the admin approving the request. Empty = espOS <hostname>.","type":"string","default":"","maxLength":63},"permissions":{"title":"Requested permissions","description":"readwrite is needed to publish deltas.","type":"string","default":"readwrite","maxLength":9,"enum":["readonly","readwrite","admin"]},"check_s":{"title":"Token check interval","description":"How often an approved token is verified against the server (detects revocation).","type":"integer","default":60,"minimum":10,"maximum":3600,"x-espos-unit":"s"},"discover_s":{"title":"Discovery interval","type":"integer","default":60,"minimum":15,"maximum":3600,"x-espos-unit":"s"},"ws_enabled":{"title":"Stream deltas","description":"Keep a WebSocket to the server open and send published values as deltas.","type":"boolean","default":true},"batch_ms":{"title":"Delta batching window","description":"Values published within this window go out as one delta message.","type":"integer","default":100,"minimum":10,"maximum":5000,"x-espos-unit":"ms"},"timestamps":{"title":"Timestamp deltas","description":"Put the time a value was MEASURED on every delta, once the device knows what time it is (see the Clock settings). Without it the server stamps each message when it arrives, so an outage's worth of buffered data lands as one burst at reconnect instead of spread over the hours it was recorded. Off = the old behaviour, and the only reason to want it is a server you would rather have stamp everything itself.","type":"boolean","default":true},"buffer_msgs":{"title":"Offline buffer (messages)","description":"Delta messages kept while the server is unreachable; oldest are dropped first.","type":"integer","default":128,"minimum":8,"maximum":1024},"buffer_kb":{"title":"Offline buffer (size)","type":"integer","default":32,"minimum":4,"maximum":512,"x-espos-unit":"KiB"},"drain_per_s":{"title":"Backlog drain rate","description":"Buffered messages per second sent after a reconnect, so the server is not swamped.","type":"integer","default":20,"minimum":1,"maximum":200,"x-espos-unit":"1/s"},"health_s":{"title":"Device health interval","description":"Publish uptime, heap, RSSI, reconnects and reset reason this often. 0 = off.","type":"integer","default":10,"minimum":0,"maximum":3600,"x-espos-unit":"s"},"stall_s":{"title":"Stream stall before restart","description":"WiFi reports connected and the stream has worked since boot, yet it has been down this long: the device raises skLinkStalled as a fatal health condition and the health watchdog restarts it, because a wedged radio link is the one network fault a restart fixes. Generous on purpose so a server restart never reboots the device; raise it if your server takes longer to come back.","type":"integer","default":300,"minimum":60,"maximum":3600,"x-espos-unit":"s"}},"additionalProperties":false,"description":"Which SignalK server to talk to and how to obtain access. The device identity (clientId) and the token itself live in device state, not here."},"time":{"type":"object","title":"Clock","x-espos-version":1,"properties":{"sntp":{"title":"Set the clock from NTP","description":"Ask an NTP server for the time once the network is up. Off = the clock comes only from the SignalK stream or a manual set, which is what a device on a boat network with no internet route wants.","type":"boolean","default":true,"x-espos-restartRequired":true},"server0":{"title":"NTP server","description":"Host name or IP. Empty and with DHCP off, nothing is asked.","type":"string","default":"pool.ntp.org","maxLength":63,"x-espos-restartRequired":true},"server1":{"title":"Second NTP server","description":"Optional fallback, used when the first does not answer.","type":"string","default":"","maxLength":63,"x-espos-restartRequired":true},"from_dhcp":{"title":"Use the NTP server DHCP offers","description":"Many routers hand out an NTP server with the lease, and it is usually the router itself вЂ” reachable even when the boat has no internet. A DHCP-supplied server replaces the list above and is refreshed on every new lease.","type":"boolean","default":true,"x-espos-restartRequired":true},"sk_fallback":{"title":"Fall back to the SignalK clock","description":"While the clock is unset, take the time from navigation.datetime on the SignalK stream. The server usually has GPS time, so a device with no internet route still gets a usable clock. Dropped as soon as NTP succeeds.","type":"boolean","default":true},"tz":{"title":"Timezone (POSIX TZ)","description":"For displays only вЂ” nothing espOS sends is ever in local time. POSIX form, e.g. UTC0, CET-1CEST,M3.5.0,M10.5.0/3 for central Europe. Note the POSIX sign convention: the offset is west-positive, so CET (UTC+1) is written -1.","type":"string","default":"UTC0","maxLength":39}},"additionalProperties":false,"description":"Where the device learns what time it is. Everything espOS publishes is UTC; the timezone below is for displays only."},"wifi":{"type":"object","title":"WiFi","x-espos-version":2,"properties":{"sta_enabled":{"title":"Station enabled","description":"Connect to the configured networks. Off = radio idle (portal still available if enabled).","type":"boolean","default":true},"hostname":{"title":"Hostname (moved to Network)","description":"Superseded by net.hostname. A value here is moved there at the next boot and this key is cleared; set the hostname under Network.","type":"string","default":"","maxLength":32,"pattern":"^[A-Za-z0-9-]*$","x-espos-restartRequired":true},"ssid0":{"title":"Network 1 SSID","type":"string","default":"","maxLength":32},"psk0":{"title":"Network 1 password","description":"Empty for an open network, else 8..63 characters (WPA).","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid0":{"title":"Network 1 BSSID pin","description":"Optional aa:bb:cc:dd:ee:ff to pin one access point (no roaming).","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid1":{"title":"Network 2 SSID","type":"string","default":"","maxLength":32},"psk1":{"title":"Network 2 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid1":{"title":"Network 2 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid2":{"title":"Network 3 SSID","type":"string","default":"","maxLength":32},"psk2":{"title":"Network 3 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid2":{"title":"Network 3 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ssid3":{"title":"Network 4 SSID","type":"string","default":"","maxLength":32},"psk3":{"title":"Network 4 password","type":"string","default":"","maxLength":64,"pattern":"^(.{8,63})?$","writeOnly":true,"format":"password","x-espos-secret":true},"bssid3":{"title":"Network 4 BSSID pin","type":"string","default":"","maxLength":17,"pattern":"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$|^$"},"ip_mode":{"title":"Addressing","description":"dhcp = take an address from the router. static = use the address below; applied before every connection, so a change takes effect at the next (re)connect or reboot.","type":"string","default":"dhcp","maxLength":6,"enum":["dhcp","static"],"x-espos-restartRequired":true},"ip":{"title":"Static IP address","description":"IPv4 address for ip_mode = static. Invalid or empty falls back to DHCP with a warning in the log.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"netmask":{"title":"Static netmask","description":"e.g. 255.255.255.0. Required with a static address.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"gateway":{"title":"Static gateway","description":"Default router. Empty = none (the device then reaches its own subnet only).","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"dns0":{"title":"Static DNS 1","description":"Primary resolver with a static address. Empty = the gateway.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"dns1":{"title":"Static DNS 2","description":"Backup resolver with a static address. Empty = none.","type":"string","default":"","maxLength":15,"pattern":"^((25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1?[0-9]?[0-9])$|^$","x-espos-restartRequired":true},"backoff_max_s":{"title":"Reconnect backoff cap","description":"Exponential backoff between rounds over all networks, 1 s doubling up to this cap, В±25 % jitter.","type":"integer","default":60,"minimum":5,"maximum":600,"x-espos-unit":"s"},"dhcp_tmo_s":{"title":"DHCP timeout","description":"Associated but no IP after this long counts as a failed attempt.","type":"integer","default":15,"minimum":3,"maximum":120,"x-espos-unit":"s"},"connect_tmo_s":{"title":"Connect timeout","description":"Safety net if the driver never reports a result.","type":"integer","default":20,"minimum":5,"maximum":120,"x-espos-unit":"s"},"portal_enabled":{"title":"Provisioning access point","description":"Bring up the setup access point when no network is configured or nothing connects for a while.","type":"boolean","default":true},"portal_after_s":{"title":"Portal after","description":"Seconds without a connection before the access point comes up (0 networks configured: immediately).","type":"integer","default":90,"minimum":10,"maximum":3600,"x-espos-unit":"s"},"portal_ssid":{"title":"Access point SSID","description":"Empty = espOS-<last 4 hex of the device MAC>.","type":"string","default":"","maxLength":32},"portal_psk":{"title":"Access point password","descriptio