# SPDX-License-Identifier: LicenseRef-Source-Available-No-Redistribution
#
# Waveshare ESP32-P4 + ESP32-C6 co-processor over SDIO.
#
# Mirrors espos/sdkconfig.defaults.esp32p4 (espOS owns the rationale) and adds
# the BLE half: the P4 has no radio of its own, so Bluedroid's HCI is routed
# at the C6 through esp_hosted's VHCI transport.
#
# NOTE: the PSRAM/cache settings below are on espOS's fix/hosted-dma-psram-p4
# branch, not yet on main. Carried here so this project does not depend on an
# unmerged branch; drop them once the submodule pin includes them.

# --- P4 silicon --------------------------------------------------------
# Waveshare boards use an ES die; without this the app panics with an Illegal
# Instruction at entry.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- esp_hosted SDIO transport to the C6 -------------------------------
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
# Streaming mode must stay ON: the C6 slave firmware is fixed in streaming mode.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_WIFI_RMT_RX_BA_WIN=6

# The P4's GDMA reaches PSRAM through cache (SOC_PSRAM_DMA_CAPABLE=1), which
# keeps esp_hosted's pools out of the scarce internal pool.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
# ...and pin the L2 cache line to 64 bytes, because the option above depends on
# it: DMA to PSRAM must be cache-line aligned and the transport's buffer stride
# is not a multiple of 128. Selecting a 512KB L2 cache silently flips the line
# to 128B and misaligns those descriptors.
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_64B=y

# --- Bluedroid over the hosted VHCI ------------------------------------
# BT_CONTROLLER_DISABLED is what makes the host stack talk HCI to the C6
# instead of looking for a local controller the P4 does not have.
#
# Init order is load-bearing (verified 2026-08-21): the remote controller must
# be init+enabled BEFORE esp_bluedroid_attach_hci_driver(), or the first use of
# the driver's function pointers faults. See espos_ble's bring-up.
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_ESP_HOSTED_ENABLE_BT_BLUEDROID=y
CONFIG_ESP_HOSTED_BLUEDROID_HCI_VHCI=y
