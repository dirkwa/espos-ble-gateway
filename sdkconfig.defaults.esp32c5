#
# ESP32-C5: WiFi buffer pools sized for the RAM this chip actually has.
#
# The C5 is single-core with ~166 KiB of internal RAM available for dynamic
# allocation (heap_init reports "At 40832AD0 len 00029AD0 (166 KiB)"), and this
# firmware runs WiFi in STA+softAP, an HTTP server and Bluedroid on it. The IDF
# defaults are sized for a chip with more headroom, and on this one they let the
# radio take a third of internal RAM before anything else has asked:
#
#   static  RX 10 x 1704 B = 16.6 KB   allocated up front
#   dynamic RX 32 x 1704 B = 53.2 KB   on demand
#   -> 69.9 KB of 166 KB, for receive buffers alone
#
# Measured with heap tracing on a Waveshare ESP32-C5 (espOS issue #124): with
# the setup portal up and nothing draining the stack, 20 of the 1704 B dynamic
# buffers were outstanding after 25 s (34 KB) and internal free fell from 172 KB
# to 16 KB. Bluedroid then cannot start at all -- "BLE unavailable:
# ESP_ERR_NO_MEM" -- so the gateway never does its job.
#
# The buffer size is the giveaway: the boot log prints "Init static rx buffer
# size: 1700", and 1704 is that plus the allocator header.
#
# A dynamic RX buffer is freed once the TCP/IP stack has taken the frame
# (esp_wifi Kconfig), so these are meant to be transient and the pool only
# climbs when delivery is not keeping up. Capping it does not stop that
# happening; it bounds what it can cost.
#
# Measured on the board, portal up and no SignalK server, before -> after:
#
#   reboots in 5 min      loop (~30 s apart)   0
#   internal RAM          "exhausted" in 10 s  "low" only, no alarm
#   health strikes        3/3 -> reboot        0
#
# The rest of this paragraph describes the build WITHOUT PSRAM; the PSRAM block
# below is what lets Bluedroid start.
#
# What it does NOT fix, and this is the honest limit of this change: internal
# RAM still falls ~270 B per 10 s health tick (measured 20312 -> 16232 B over
# 150 s, so 27 B/s), and Bluedroid still cannot start ("BLE unavailable:
# ESP_ERR_NO_MEM"). From 20 KB free that reaches the 12 KB alarm floor in about
# 5 minutes, not the 15 an earlier version of this comment claimed -- the
# mitigation buys minutes, not quarter-hours. What it does buy is a device that
# declines slowly instead of reboot-looping within 30 s, which is the difference
# between "usable long enough to configure" and "unusable". The remaining drain
# is unexplained and tracked in espOS issue #124.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12

# TX likewise: 32 buffers is throughput sizing, and this firmware sends small
# JSON deltas and BLE advertisement reports, not bulk data.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12

# Management frames: 32 is generous for a device that associates with one AP
# and serves a handful of portal clients.
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# AMPDU RX stays enabled -- disabling it costs real throughput -- but the block
# ack window is what decides how many frames may be in flight unacknowledged,
# and 6 is already IDF's non-PSRAM default. Left explicit so a future PSRAM
# build does not silently inherit the 16 that SPIRAM_TRY_ALLOCATE_WIFI_LWIP
# would select on a chip that has none to spare.
CONFIG_ESP_WIFI_RX_BA_WIN=6

# --- PSRAM: what makes Bluedroid fit (signalk-espOS/espOS#207) ----------------
#
# Everything above bounds what WiFi can take; it never made room for BLE. The
# C5 modules carry 8 MB of PSRAM, which the defaults leave off. With it on, only
# the BLE controller, WiFi/lwIP and DMA buffers have to stay internal. The block
# below matches espOS's ble_gateway example for this target; docs/hardware.md
# there has the measurements, and the rev v1.0 note on PSRAM encryption.
CONFIG_SPIRAM=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Static RX buffers must be internal; 6 (= the block-ack window) frees 6.4 KB,
# which is what lets the control WebSocket fit beside everything else.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# WiFi library code back to flash. On the C5 code and data share one SRAM,
# so every KB of IRAM the driver claims for speed is a KB less heap. IDF puts
# these four in IRAM by default on a WiFi 6 part (IRAM_OPT >10 KB, RX >17 KB,
# EXTRA >5 KB, SLP ~7 KB per their Kconfig help); the cost of moving them is
# throughput, which a gateway posting a few KB every 2 s does not use. Matches
# espOS's ble_gateway example (signalk-espOS/espOS#214), where it raised the
# internal-RAM low point from 15.8 to 25.5 KB. Interrupt handlers stay in IRAM.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
# NOT CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP: the station never associates with it.
# mDNS's task stack and allocations in PSRAM too: neither touches flash.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
